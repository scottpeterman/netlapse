# netlapse .gitignore

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
MANIFEST

# --- Virtual environments ------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Test / tooling caches -----------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Editors / IDEs ------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS junk -------------------------------------------------------------
.DS_Store
._*
__MACOSX/
Thumbs.db
desktop.ini

# --- Secrets: never commit -----------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
.pypirc

# --- netlapse runtime state ----------------------------------------------
# Normally lives in ~/.netlapse; these catch a NETLAPSE_CONFIG pointed at
# the repo, or a run from inside the checkout.
/config.yaml
/.netlapse/
/data/
/backups/
vault.db
netlapse.db
*.db-journal
*.db-wal
*.db-shm
ip_lookup.json
.setup-complete
.restore-*.json
*.tar.gz
*.log

# Shipped on purpose: the TextFSM template database
!/tfsm_templates.db

# --- Stray archives ------------------------------------------------------
*.zip
